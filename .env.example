# Copy to .env for local configuration. Never commit deployment values.
BEHOLDEN_SUPPORT=true
BEHOLDEN_RATE_LIMIT_WINDOW_MS=900000
BEHOLDEN_RATE_LIMIT_MAX=5000
WEB_PORT=5173
WEB_PLAYER_PORT=5175
SERVER_PORT=5174

# Only needed when a web app is served from a different host than the API. The app's own origin
# is always allowed; any other origin is refused unless listed here (comma-separated URLs).
BEHOLDEN_ALLOWED_ORIGINS=

# Set when a reverse proxy sits in front of the server: true (one proxy), a hop count, or cloudflare.
# Leave empty when clients connect directly, or they can spoof their address.
BEHOLDEN_TRUST_PROXY=

# Optional comma-separated hostnames for Vite dev/preview only.
WEB_DM_ALLOWED_HOSTS=
WEB_PLAYER_ALLOWED_HOSTS=

{
  "name": "beholden",
  "private": true,
  "engines": {
    "node": "^26.12.0",
    "npm": ">=12.2.0"
  },
  "packageManager": "npm@12.2.0",
  "workspaces": [
    "shared",
    "server",
    "web-dm",
    "web-player"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web-dm\" \"npm:dev:web-player\"",
    "dev:server": "npm -w server run dev",
    "dev:web-dm": "npm -w web-dm run dev",
    "dev:web-player": "npm -w web-player run dev",
    "db:maintenance": "npm -w server run db:maintenance --",
    "typecheck": "npm -w server run typecheck && npm -w web-dm run typecheck && npm -w web-player run typecheck",
    "lint": "eslint \"{server,shared,web-dm,web-player}/src/**/*.{ts,tsx}\" --cache --cache-location .eslintcache",
    "build": "npm -w server run build && npm -w web-dm run build && npm -w web-player run build",
    "build:web-dm": "npm -w web-dm run build",
    "build:web-player": "npm -w web-player run build",
    "start": "npm -w server run start",
    "test": "npm -w server run test && npm -w web-player run test && npm -w web-dm run test",
    "check:payload-budgets": "node scripts/checks/check-payload-budgets.mjs",
    "check:bundle-budgets": "node scripts/checks/check-bundle-budgets.mjs",
    "profile:runtime": "node --import tsx scripts/checks/profile-node-runtime.mjs",
    "benchmark:runtimes": "node scripts/checks/benchmark-node-versions.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:payload-budgets && npm run check:bundle-budgets"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.1": true
  }
}
